{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcdhub",
  "account_id": "cea2cd02060a70151f8c3690f1163cd9",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcdhub",
      "database_id": "8b1a0242-30c0-43e9-87c2-2932f25a1bcb"
    }
  ]
}
